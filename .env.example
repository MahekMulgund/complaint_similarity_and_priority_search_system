# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=antigravity-complaint-system-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=complaint_db

# Algorithmic Parameters (Configurable)
SIMILARITY_THRESHOLD=0.50

# Priority Engine Weights (Must sum to 1.0)
PRIORITY_WEIGHT_COUNT=0.35
PRIORITY_WEIGHT_SEVERITY=0.25
PRIORITY_WEIGHT_AFFECTED=0.25
PRIORITY_WEIGHT_RECENCY=0.15

# Priority Normalization Limits
PRIORITY_C_MAX=10
PRIORITY_U_MAX=50
PRIORITY_RECENCY_DECAY=2.0
